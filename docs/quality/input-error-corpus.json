{
  "schema_version": 1,
  "cases": [
    {
      "id": "deck-missing-slides",
      "kind": "deck",
      "input": { "title": "Brak slajdów" },
      "field": "slides",
      "expected_pattern": "array|Required"
    },
    {
      "id": "deck-slides-object",
      "kind": "deck",
      "input": { "slides": { "type": "title", "title": "Nie tablica" } },
      "field": "slides",
      "expected_pattern": "array|Expected"
    },
    {
      "id": "deck-invalid-discriminator",
      "kind": "deck",
      "input": { "slides": [{ "layout": "metrics", "flows": { "main": { "blocks": [{ "type": "metrc", "label": "Literówka", "value": 1 }] } } }] },
      "field": "type",
      "expected_pattern": "discriminator|Invalid"
    },
    {
      "id": "deck-title-wrong-type",
      "kind": "deck",
      "input": { "slides": [{ "layout": "title", "flows": { "title": { "blocks": [{ "type": "heading", "text": 42 }] } } }] },
      "field": "text",
      "expected_pattern": "string|Expected"
    },
    {
      "id": "deck-metric-label-missing",
      "kind": "deck",
      "input": { "slides": [{ "layout": "metrics", "flows": { "main": { "blocks": [{ "type": "metric", "value": 42 }] } } }] },
      "field": "label",
      "expected_pattern": "Required|string|Expected"
    },
    {
      "id": "deck-flows-missing",
      "kind": "deck",
      "input": { "slides": [{ "layout": "columns" }] },
      "field": "flows",
      "expected_pattern": "Required|object|Expected"
    },
    {
      "id": "deck-metrics-value-object",
      "kind": "deck",
      "input": {
        "slides": [{
          "layout": "metrics",
          "flows": { "main": { "blocks": [{ "type": "metric", "label": "KPI", "value": { "raw": 42 } }] } }
        }]
      },
      "field": "value",
      "expected_pattern": "string|number|Expected"
    },
    {
      "id": "report-blocks-object",
      "kind": "report",
      "input": { "flows": { "main": { "blocks": {} } } },
      "field": "blocks",
      "expected_pattern": "array|Expected"
    },
    {
      "id": "report-chart-data-empty",
      "kind": "report",
      "input": { "flows": { "main": { "blocks": [{ "type": "chart", "chart_type": "bar", "data": [] }] } } },
      "field": "data",
      "expected_pattern": "at least 1|too_small|Array"
    },
    {
      "id": "report-chart-type-typo",
      "kind": "report",
      "input": { "flows": { "main": { "blocks": [{ "type": "chart", "chart_type": "column", "data": [{ "label": "A", "value": 1 }] }] } } },
      "field": "chart_type",
      "expected_pattern": "bar|line|pie|Invalid"
    },
    {
      "id": "report-table-head-missing",
      "kind": "report",
      "input": { "flows": { "main": { "blocks": [{ "type": "table", "body": [["SEO", 42]] }] } } },
      "field": "head",
      "expected_pattern": "Required|array|Expected"
    },
    {
      "id": "report-section-level-invalid",
      "kind": "report",
      "input": { "flows": { "main": { "blocks": [{ "type": "heading", "text": "Rozdział", "level": 3 }] } } },
      "field": "level",
      "expected_pattern": "1|2|Invalid"
    }
  ]
}
