{
  "name": "report-baby-server",
  "version": "0.9.5",
  "description": "Self-contained SVG/data → PNG/PDF render MCP server (resvg-wasm + jsPDF, zero runtime deps)",
  "type": "module",
  "main": "bundle.cjs",
  "scripts": {
    "build": "npm run build:templates && tsc --noEmit && npm run build:mcp && npm run build:example && npm run build:brand-tool && npm run build:cli",
    "build:templates": "node scripts/generate-builtin-templates.mjs",
    "build:mcp": "npx esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=bundle.cjs",
    "build:example": "npx esbuild src/example.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=example-bundle.cjs",
    "build:brand-tool": "npx esbuild src/brand-tool.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=brand-tool-bundle.cjs",
    "build:cli": "npx esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=cli-bundle.cjs",
    "baseline:record": "node scripts/baseline.mjs record",
    "baseline:verify": "node scripts/baseline.mjs verify",
    "test:manifest": "npm run build:example && node scripts/test-manifest-contract.mjs",
    "test:manifest-consumers": "node scripts/test-showcase-manifest-consumers.mjs",
    "goals:input-errors": "node scripts/test-input-errors.mjs",
    "test:mcp-schema": "node scripts/test-mcp-schema-snapshot.mjs",
    "goals:config-reach": "node scripts/test-config-reach.mjs",
    "arch:check": "node scripts/architecture-check.mjs",
    "goals:script-dup": "node scripts/script-dup.mjs",
    "test:brand": "node ../scripts/test-brand-contract.js",
    "test:brand-release-template": "node scripts/test-brand-release-template.mjs",
    "test:brand-assets": "node scripts/test-brand-assets.mjs",
    "test:report-plan": "node scripts/test-report-plan.mjs",
    "test:fallback-cache": "node scripts/test-fallback-cache.mjs",
    "test:report-layout": "node scripts/test-report-layout.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "test:source-context": "node scripts/test-source-context.mjs",
    "test:source-materialization": "node scripts/test-source-materialization.mjs",
    "test:markdown-normalizer": "node scripts/test-markdown-normalizer.mjs",
    "test:image-resolver": "node scripts/test-image-resolver.mjs",
    "test:report-images": "node scripts/test-report-images.mjs",
    "test:slide-artifacts": "node scripts/test-slide-artifacts.mjs",
    "test:editorial-flow": "node scripts/test-editorial-flow.mjs",
    "prototype:composition": "node scripts/prototype-composition-kernel.mjs",
    "prototype:engine-spike": "node scripts/editorial-engine-spike.mjs",
    "prototype:reserved-slot": "node scripts/editorial-reserved-slot-spike.mjs",
    "prototype:pure-planner": "node scripts/pure-layout-planner-prototype.mjs",
    "prototype:report-baby-adapter": "node scripts/prototype-report-baby-adapter.mjs",
    "test:prototype-report-baby": "node scripts/test-prototype-report-baby.mjs",
    "test:prototype-composition": "node scripts/test-prototype-composition.mjs",
    "test:prototype-pixel-qa": "node scripts/test-prototype-pixel-qa.mjs",
    "test:prototype-pdf-parity": "node scripts/test-prototype-pdf-parity.mjs",
    "test:prototype-star-occlusion": "node scripts/test-prototype-star-occlusion.mjs",
    "test:prototype-landscape": "node scripts/test-prototype-landscape.mjs",
    "test:prototype-breaking": "node scripts/test-prototype-breaking-corpus.mjs",
    "test:prototype-boundary": "node scripts/test-prototype-boundary-sweeps.mjs",
    "test:prototype-writing-systems": "node scripts/test-prototype-writing-systems.mjs",
    "test:prototype-planner-seam": "node scripts/test-prototype-planner-seam.mjs",
    "test:prototype-engine-adapter": "node scripts/test-prototype-engine-adapter.mjs",
    "test:prototype-engine-adapter-corpus": "node scripts/test-prototype-engine-adapter-corpus.mjs",
    "test:composition-data-adapter": "node scripts/test-composition-report-data-adapter.mjs",
    "test:composition-engine-contract": "node scripts/test-composition-engine-contract.mjs",
    "test:template-flow-contract": "node scripts/test-template-flow-contract.mjs",
    "test:text-composition-engine": "node scripts/test-text-composition-engine.mjs",
    "test:page-template-adapter": "node scripts/test-page-template-adapter.mjs",
    "test:report-composition-shadow": "node scripts/test-report-composition-shadow.mjs",
    "test:report-composition-oracle": "node scripts/test-report-composition-oracle.mjs",
    "test:editorial-numbered-flow": "node scripts/test-editorial-numbered-flow.mjs",
    "test:report-composition-image": "node scripts/test-report-composition-image.mjs",
    "test:composition-gate": "npm run test:report-composition-shadow && npm run test:report-composition-oracle && npm run test:text-composition-engine && npm run test:report-composition-image && npm run test:page-template-adapter && npm run test:js-pdf-adapter && npm run test:editorial-numbered-flow",
    "test:legacy-gate": "npm run test:template-flow-contract && npm run test:report-plan && npm run test:report-images && npm run test:editorial-flow",
    "test:js-pdf-adapter": "node scripts/test-js-pdf-adapter.mjs",
    "test:prototype-flow-boxes": "node scripts/test-prototype-flow-boxes.mjs",
    "compare:pdf-layout": "node scripts/compare-pdf-layout.mjs",
    "test:pdf-layout-diff": "node scripts/test-pdf-layout-diff.mjs",
  "test": "node scripts/test-public-behavior.mjs && npm run test:composition-gate && npm run test:legacy-gate",
    "dev": "tsc --watch --noEmit",
    "start": "node bundle.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "linkedom": "^0.18.13",
    "mdast-util-to-string": "^4.0.0",
    "pptxgenjs": "^4.0.1",
    "remark-parse": "^11.0.0",
    "svg2pdf.js": "^2.7.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "esbuild": "^0.28.1",
    "lorem-ipsum": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
