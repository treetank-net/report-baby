{
  "name": "report-baby-server",
  "version": "0.1.1",
  "description": "Headless-Chromium HTML/data → PDF/PNG render MCP server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npx esbuild dist/index.js --bundle --platform=node --target=node18 --format=cjs --minify --external:playwright --outfile=bundle.cjs",
    "dev": "tsc --watch",
    "start": "node bundle.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "playwright": "^1.48.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
