{
  "name": "report-baby-server",
  "version": "1.0.0",
  "description": "Self-contained SVG/data → PNG/PDF render MCP server (resvg-wasm + jsPDF, zero runtime deps)",
  "type": "module",
  "main": "bundle.cjs",
  "scripts": {
    "build": "npm run build:templates && tsc --noEmit && npm run build:mcp && npm run build:example && npm run build:brand-tool && npm run build:cli",
    "build:templates": "node scripts/generate-builtin-templates.mjs",
    "build:mcp": "npx esbuild src/interfaces/mcp/server.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=bundle.cjs",
    "build:example": "npx esbuild src/interfaces/cli/example.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=example-bundle.cjs",
    "build:brand-tool": "npx esbuild src/interfaces/cli/brand-tool.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=brand-tool-bundle.cjs",
    "build:cli": "npx esbuild src/interfaces/cli/cli.ts --bundle --platform=node --target=node18 --format=cjs --minify --loader:.wasm=binary --loader:.ttf=binary --outfile=cli-bundle.cjs",
    "baseline:record": "node scripts/baseline.mjs record",
    "baseline:verify": "node scripts/baseline.mjs verify",
    "test:brand": "node scripts/test-brand-contract.mjs",
    "test:smoke": "node scripts/test-harness.mjs --suite smoke",
    "test:release": "node scripts/test-harness.mjs --suite all",
    "test": "node scripts/test-harness.mjs",
    "test:artifacts": "node scripts/test-harness.mjs --suite artifacts",
    "test:composition": "node scripts/test-harness.mjs --suite composition",
    "test:editorial-full": "node scripts/test-editorial-flow-full.mjs",
    "test:timings": "node scripts/test-timings.mjs",
    "test:quality": "node scripts/test-harness.mjs --suite quality",
    "planner:inventory": "node scripts/planner-function-dependency-report.mjs --annotate --write-report ../docs/release-1.0/planner-function-dependency-inventory.md",
    "planner:coverage-report": "node scripts/flow-planner-coverage-report.mjs",
    "dev": "tsc --watch --noEmit",
    "start": "node bundle.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "linkedom": "^0.18.13",
    "mdast-util-to-string": "^4.0.0",
    "pptxgenjs": "^4.0.1",
    "remark-parse": "^11.0.0",
    "svg2pdf.js": "^2.7.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "esbuild": "^0.28.1",
    "lorem-ipsum": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
